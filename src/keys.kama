file @compileFor(!ARCH_WASM32);
// rmlui keys — RmlUi's own key identifiers (`Rml::Input::KeyIdentifier`) and modifier bits, as kama constants.
//
// These are RmlUi's numbers, not any windowing library's: a program maps its platform's key codes to these once, in
// its input layer (@kama/ui does it for GLFW-numbered codes). csrc/kama_rmlui.cpp `static_assert`s every value spelled
// here, so an RmlUi upgrade that moved one fails to compile by name rather than pressing the wrong key.
//
// The subset is what a UI needs: text editing, navigation, function keys. The full enum (IME and OEM keys) is in
// third_party/rmlui/Include/RmlUi/Core/Input.h; any value from it may be passed to `Context.key` as an int32.

export {
    KEY_SPACE, KEY_0, KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9,
    KEY_A, KEY_B, KEY_C, KEY_D, KEY_E, KEY_F, KEY_G, KEY_H, KEY_I, KEY_J, KEY_K, KEY_L, KEY_M,
    KEY_N, KEY_O, KEY_P, KEY_Q, KEY_R, KEY_S, KEY_T, KEY_U, KEY_V, KEY_W, KEY_X, KEY_Y, KEY_Z,
    KEY_NUMPAD_ENTER, KEY_BACKSPACE, KEY_TAB, KEY_RETURN, KEY_ESCAPE, KEY_PAGE_UP, KEY_PAGE_DOWN, KEY_END, KEY_HOME,
    KEY_LEFT, KEY_UP, KEY_RIGHT, KEY_DOWN, KEY_INSERT, KEY_DELETE,
    KEY_F1, KEY_F2, KEY_F3, KEY_F4, KEY_F5, KEY_F6, KEY_F7, KEY_F8, KEY_F9, KEY_F10, KEY_F11, KEY_F12,
    MOD_NONE, MOD_CTRL, MOD_SHIFT, MOD_ALT, MOD_META, MOD_CAPSLOCK, MOD_NUMLOCK, MOD_SCROLLLOCK,
};

comptime int32 KEY_SPACE = 1;
comptime int32 KEY_0 = 2;
comptime int32 KEY_1 = 3;
comptime int32 KEY_2 = 4;
comptime int32 KEY_3 = 5;
comptime int32 KEY_4 = 6;
comptime int32 KEY_5 = 7;
comptime int32 KEY_6 = 8;
comptime int32 KEY_7 = 9;
comptime int32 KEY_8 = 10;
comptime int32 KEY_9 = 11;
comptime int32 KEY_A = 12;
comptime int32 KEY_B = 13;
comptime int32 KEY_C = 14;
comptime int32 KEY_D = 15;
comptime int32 KEY_E = 16;
comptime int32 KEY_F = 17;
comptime int32 KEY_G = 18;
comptime int32 KEY_H = 19;
comptime int32 KEY_I = 20;
comptime int32 KEY_J = 21;
comptime int32 KEY_K = 22;
comptime int32 KEY_L = 23;
comptime int32 KEY_M = 24;
comptime int32 KEY_N = 25;
comptime int32 KEY_O = 26;
comptime int32 KEY_P = 27;
comptime int32 KEY_Q = 28;
comptime int32 KEY_R = 29;
comptime int32 KEY_S = 30;
comptime int32 KEY_T = 31;
comptime int32 KEY_U = 32;
comptime int32 KEY_V = 33;
comptime int32 KEY_W = 34;
comptime int32 KEY_X = 35;
comptime int32 KEY_Y = 36;
comptime int32 KEY_Z = 37;
comptime int32 KEY_NUMPAD_ENTER = 61;
comptime int32 KEY_BACKSPACE = 69;     // RmlUi's KI_BACK
comptime int32 KEY_TAB = 70;
comptime int32 KEY_RETURN = 72;
comptime int32 KEY_ESCAPE = 81;
comptime int32 KEY_PAGE_UP = 86;       // KI_PRIOR
comptime int32 KEY_PAGE_DOWN = 87;     // KI_NEXT
comptime int32 KEY_END = 88;
comptime int32 KEY_HOME = 89;
comptime int32 KEY_LEFT = 90;
comptime int32 KEY_UP = 91;
comptime int32 KEY_RIGHT = 92;
comptime int32 KEY_DOWN = 93;
comptime int32 KEY_INSERT = 98;
comptime int32 KEY_DELETE = 99;
comptime int32 KEY_F1 = 107;
comptime int32 KEY_F2 = 108;
comptime int32 KEY_F3 = 109;
comptime int32 KEY_F4 = 110;
comptime int32 KEY_F5 = 111;
comptime int32 KEY_F6 = 112;
comptime int32 KEY_F7 = 113;
comptime int32 KEY_F8 = 114;
comptime int32 KEY_F9 = 115;
comptime int32 KEY_F10 = 116;
comptime int32 KEY_F11 = 117;
comptime int32 KEY_F12 = 118;

// Modifier bits, OR-ed into the `mods` every input call takes (RmlUi's KeyModifier).
comptime int32 MOD_NONE = 0;
comptime int32 MOD_CTRL = 1;
comptime int32 MOD_SHIFT = 2;
comptime int32 MOD_ALT = 4;
comptime int32 MOD_META = 8;
comptime int32 MOD_CAPSLOCK = 16;
comptime int32 MOD_NUMLOCK = 32;
comptime int32 MOD_SCROLLLOCK = 64;
