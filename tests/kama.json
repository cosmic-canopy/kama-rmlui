{
  "name": "rmlui_tests",
  "version": "0.1.0",
  "kind": "executable",
  "kama": ">=0.9.577",
  "entry": "src/main.kama",
  "dependencies": { "@kama/rmlui": { "path": ".." } },
  "modules": { ".": { "visibility": "internal" } },
  "select": {
    "TARGET": {
      "HOST":    { "ldflags": ["-Lnative/build/linux/lib", "-Lnative/build/darwin/lib", "-Lnative/build/windows/lib"] },
      "LINUX":   { "ldflags": ["-Lnative/build/linux/lib"] },
      "MACOS":   { "ldflags": ["-Lnative/build/darwin/lib"] },
      "WINDOWS": { "ldflags": ["-Lnative/build/windows/lib", "-static-libgcc", "-Wl,-Bstatic", "-lstdc++", "-lpthread", "-Wl,-Bdynamic"] }
    }
  }
}
