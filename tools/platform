#!/usr/bin/env bash
# tools/platform — which platform this is, in ONE place for every script and the Makefile.
#
#   tools/platform           darwin | linux | windows — the suffix on every per-platform directory
#                            (native/build/<plat>)
#   tools/platform target    the kama `--target` that builds natively here: MACOS | LINUX | WINDOWS
#   tools/platform macos-min the oldest macOS a Mac build targets (handed to cmake and the shim)
#
# From the-mallow-man's tools/platform (itself friendly-fire-department@f8a4265's). RUN, not sourced, so the
# Makefile asks the same question as the shell scripts.
#
# ⚠️ **WINDOWS IS WHY THIS EXISTS.** Under MSYS2 `uname -s` is `MINGW64_NT-10.0-26200-ARM64`: lowercasing it bakes
# the Windows BUILD NUMBER into a directory name, so an OS update would orphan native/build/. Anything
# MINGW/MSYS is `windows` here.
MACOS_MIN=12.0

set -eu

case "$(uname -s)" in
  Darwin)                plat=darwin ;;
  Linux)                 plat=linux ;;
  MINGW*|MSYS*|CYGWIN*)  plat=windows ;;
  *) echo "tools/platform: unrecognised platform $(uname -s)" >&2; exit 1 ;;
esac

case "${1:-}" in
  "")        printf '%s\n' "$plat" ;;
  target)
    case "$plat" in
      darwin)  printf 'MACOS\n' ;;
      linux)   printf 'LINUX\n' ;;
      windows) printf 'WINDOWS\n' ;;
    esac
    ;;
  macos-min) printf '%s\n' "$MACOS_MIN" ;;
  *) echo "tools/platform: unknown question '$1' — ask for nothing, 'target' or 'macos-min'" >&2; exit 2 ;;
esac
